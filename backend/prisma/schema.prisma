generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


enum ModeloFasico {
  monofasico
  bifasico
  trifasico
}

enum Enquadramento {
  AX
  B1
  B2
  B3
}

model Lead {
  id          String   @id @default(uuid())
  nomeCompleto String
  email       String   @unique
  telefone    String
  createdAt   DateTime @default(now())

  unidades    Unidade[]
}

model Unidade {
  id                        String       @id @default(uuid())
  codigoDaUnidadeConsumidora String      @unique
  modeloFasico              ModeloFasico
  enquadramento             Enquadramento

  leadId                    String
  lead                      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  historicoDeConsumoEmKWH   Consumo[]
}

model Consumo {
  id                    String   @id @default(uuid())
  consumoForaPontaEmKWH Float
  mesDoConsumo          DateTime

  unidadeId              String
  unidade                Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@unique([unidadeId, mesDoConsumo])
}
